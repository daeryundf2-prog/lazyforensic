{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Loading Gemini host contract",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|replace_file_content|ReplaceFileContent|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|generate_document|fill_form|Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute|execute_command)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/evidence_guard.mjs\" pre-tool-use",
						"timeout": 5,
						"statusMessage": "LazyForensic: Guarding Evidence Integrity (Write-Lock, best-effort)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|replace_file_content|ReplaceFileContent|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|generate_document|fill_form)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/evidence_guard.mjs\" post-tool-use",
						"timeout": 5,
						"statusMessage": "LazyForensic: Logging SHA-256 Audit Trail",
						"failurePolicy": "FAIL_OPEN"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hallucination_guard.mjs\"",
						"timeout": 30,
						"statusMessage": "LazyForensic: Verifying report (보고서/검토해줘 무조건 검증)",
						"failurePolicy": "FAIL_CLOSED"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/markdown_structure_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Markdown structure guard (스트리핑/빈 링크/표 불일치)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			},
			{
				"matcher": "^(Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute|execute_command)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hallucination_guard.mjs\"",
						"timeout": 30,
						"statusMessage": "LazyForensic: Verifying report (bash 리다이렉트 쓰기 포함)",
						"failurePolicy": "FAIL_CLOSED"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/markdown_structure_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Markdown structure guard (bash 리다이렉트 쓰기 포함)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Restoring Gemini host contract",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/stop_claim_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Stop claim guard (무근거 완료 선언 차단)"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/stop_claim_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyForensic: Subagent stop claim guard (무근거 완료 선언 차단)"
					}
				]
			}
		]
	}
}
